{
  "name": "wordhush",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "db:migrate": "kysely migrate",
    "db:seed": "kysely seed",
    "db:codegen": "kysely-codegen --out-file ./src/database-schemas.ts --singularize --camel-case"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "1.3.14",
    "@types/pg": "^8.20.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "kysely-codegen": "^0.20.0",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/runner": "^2.0.3",
    "csv-parser": "^3.2.1",
    "grammy": "^1.43.0",
    "kysely": "^0.29.2",
    "kysely-ctl": "^0.21.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
