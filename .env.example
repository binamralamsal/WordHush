# =============================================================================
# WordHush CONFIGURATION
# =============================================================================

# Your Telegram bot token from @BotFather
BOT_TOKEN=

# Custom Telegram API root URL
# If your bot is giving responses slowly, you can setup local bot API server using this guide: https://tdlib.github.io/telegram-bot-api/build.html?os=Linux
CUSTOM_API_ROOT=https://api.telegram.org

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URI for current game statuses, caching and rate limits
REDIS_URI=redis://127.0.0.1:6379

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application environment (development or production)
NODE_ENV=development

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

# Google Gemini AI API keys (separated by space)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEYS=

# =============================================================================
# USER PERMISSIONS
# =============================================================================

# User IDs of users who have administrator permissions (separated by space)
# Get user ID by messaging your bot or using @userinfobot
ADMIN_USERS=